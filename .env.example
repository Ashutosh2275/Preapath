# PrepPath Environment Variables Template
# Copy this file to .env for local development

# Firebase Client Configuration (Public variables exposed to browser)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Local Dev / Mock Flag: Set to true if running without live Firebase or Judge0 backend
# Allows full frontend, planner, question bank, Monaco editor, and test case simulation testing
VITE_USE_LOCAL_MOCK_AUTH=false

# Trusted Server / Cloud Functions Execution Gateway Configuration (Server-Side Secrets)
# NEVER prefix these with VITE_ or expose to client
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-judge0-key-here
JUDGE0_AUTH_TOKEN=your-self-hosted-judge0-token-here

# Server Port (for functions / proxy gateway)
PORT=5001
