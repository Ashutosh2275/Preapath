# PrepPath Environment Variables Template
# Copy this file to .env for local development

# PostgreSQL Database Configuration (Supabase or self-hosted PostgreSQL)
# authoritative persistent storage for user profiles, study plans, drafts, test cases, and submissions
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Firebase Client Configuration (Optional authentication provider)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Trusted Server / Cloud Functions Execution Gateway Configuration (Server-Side Secrets)
# NEVER prefix these with VITE_ or expose to client
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-judge0-key-here
JUDGE0_AUTH_TOKEN=your-self-hosted-judge0-token-here

# Server Port (for functions / proxy gateway)
PORT=5001
